{
  "name": "boss-kamp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Boss Kamp — turn household chores into epic co-op battles. An offline-first PWA arcade-RPG for the whole family.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/online/*.test.ts",
    "release:check": "node scripts/release-metadata.mjs",
    "release:notes": "node scripts/release-metadata.mjs --notes",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:test": "node --test scripts/prepare-release.test.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/core": "^8.5.0",
    "@sqlite.org/sqlite-wasm": "^3.50.1-build1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
